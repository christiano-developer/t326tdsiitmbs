# Layer 4 (OS env, APP_* prefix): values come from YOUR question's "OS env vars" box.
# Not read from a file: pass them at deploy time, e.g. vercel deploy --prod -e APP_WORKERS=<n> -e APP_API_KEY=<key>
APP_WORKERS=
APP_API_KEY=
# Optional: picks config.<APP_ENV>.yaml (default: development)
APP_ENV=
